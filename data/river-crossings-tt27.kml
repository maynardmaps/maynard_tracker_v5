      <styleUrl>#PurpleRiverCrossingStyle</styleUrl>
      <Point>
        <coordinates>-3.9315,50.552,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Amber River Crossing 1</name>
      <description>Amber river crossing point</description>
      <styleUrl>#AmberRiverCrossingStyle</styleUrl>
      <Point>
        <coordinates>-3.8885,50.558,0</coordinates>
