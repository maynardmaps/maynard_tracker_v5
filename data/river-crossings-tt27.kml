<?xml version="1.0" ?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>North Moor River Crossings</name>
    <description>River crossing points from Ten Tors Training Area Map TT27</description>
    <Style id="BlueRiverCrossingStyle">
      <IconStyle>
        <scale>0.8</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/shapes/info-i.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>0.8</scale>
      </LabelStyle>
    </Style>
    <Style id="PurpleRiverCrossingStyle">
      <IconStyle>
        <scale>0.8</scale>
        <Icon>
