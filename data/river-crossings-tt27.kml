        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>0.8</scale>
      </LabelStyle>
    </Style>
    <Style id="AmberRiverCrossingStyle">
      <IconStyle>
        <scale>0.8</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/shapes/info-i.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>0.8</scale>
      </LabelStyle>
    </Style>
    <Placemark>
      <name>Blue River Crossing 1</name>
      <description>Blue river crossing point</description>
      <styleUrl>#BlueRiverCrossingStyle</styleUrl>
      <Point>
        <coordinates>-3.9405,50.554,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Blue River Crossing 2</name>
